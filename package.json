{
  "name": "next-gen-crm-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gateway": "node gateway.js",
    "dev:website": "npm --prefix website run dev",
    "dev:crm": "npm --prefix crm-panel run dev",
    "dev:backend": "cd backend && php artisan serve",
    "start-all": "node gateway.js",
    "build:cpanel": "node scripts/prepare_cpanel_deploy.js",
    "tunnel": "ngrok http 127.0.0.1:3000 --url shield-careless-impulse.ngrok-free.dev",
    "start:tunnel": "cmd /c start-ngrok.bat"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.0"
  }
}

APP_NAME="Next Gen Relocation"
APP_ENV=production
APP_KEY=base64:c74L/7p5Q90L1Hj3k4rV5n8M9tP1w2x3y4z5A6B7C8D=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ── Database (Create database and user in cPanel MySQL Database Wizard) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yourcpaneluser_crm
DB_USERNAME=yourcpaneluser_crmuser
DB_PASSWORD=your_secure_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Production Mailer (Brevo SMTP or cPanel Webmail SMTP) ──────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_login_email@example.com
MAIL_PASSWORD=your_brevo_smtp_key_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@yourdomain.com"
MAIL_FROM_NAME="Next Gen Relocation"

# ── Frontend & Public URLs ───────────────────────────────────────────
# Must point to the CRM subpath on your domain:
FRONTEND_URL=https://yourdomain.com/crm
PUBLIC_BASE_URL=https://yourdomain.com

# ── Microsoft Azure OAuth (For Outlook Sync) ─────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://yourdomain.com/api/outlook/callback

# ── Lead Automation & Reminders ──────────────────────────────────────
APP_BUSINESS_TIMEZONE=Europe/London
WORK_START_HOUR=9
WORK_END_HOUR=18
REMINDER_INTERVAL_MINUTES=120
REMINDER_JITTER_MINUTES=60
REMINDER_MAX_CYCLES=4

# ── ZegoCloud Video Calling ──────────────────────────────────────────
ZEGO_APP_ID=your_zego_app_id
ZEGO_SERVER_SECRET=your_zego_server_secret
ZEGO_APP_SIGN=your_zego_app_sign

# ── Call Storage ─────────────────────────────────────────────────────
CALL_RECORDINGS_DISK=public
CALL_RECORDING_MAX_SIZE_KB=102400
CALL_RECORDING_CONSENT_REQUIRED=true

# ── Stripe Payment Processing ────────────────────────────────────────
STRIPE_KEY=pk_live_your_stripe_key
STRIPE_SECRET=sk_live_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Whisper Transcription Microservice (Optional) ────────────────────
WHISPER_SERVICE_URL=http://127.0.0.1:9000
WHISPER_API_TOKEN=your_token
WHISPER_TIMEOUT=900
